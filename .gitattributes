# Text files are stored with LF and checked out with the platform's line endings, except the launchers,
# which need theirs on every platform.
* text=auto
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.webp binary
*.gif binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.ico binary
*.woff2 binary
*.pdf binary
